<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ThaiCMS Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .sidebar { min-height: 100vh; background-color: #212529; color: white; }
        .sidebar a { color: #adb5bd; text-decoration: none; display: block; padding: 12px 20px; transition: 0.3s;}
        .sidebar a:hover { background-color: #343a40; color: white; padding-left: 25px;}
        .sidebar .active { background-color: #0d6efd; color: white; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 sidebar p-0 position-fixed">
                <div class="p-3 text-center border-bottom border-secondary">
                    <h4 class="text-white fw-bold">ThaiCMS Admin</h4>
                </div>
                <div class="mt-3">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> Bảng điều khiển</a>
                    <a asp-controller="Category" asp-action="Index"><i class="bi bi-grid me-2"></i> Quản lý Danh mục</a>
                    <a asp-controller="Post" asp-action="Index"><i class="bi bi-file-earmark-post me-2"></i> Quản lý Bài viết</a>
                    <a asp-controller="User" asp-action="Index"><i class="bi bi-people me-2"></i> Quản lý Thành viên</a>
                    <div class="mt-auto p-3 w-100 position-absolute bottom-0 border-top border-secondary text-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="text-white mb-2 small">
                                Xin chào,<br/> 
                                <strong class="text-warning">@User.FindFirst("FullName")?.Value</strong>
                                <br/>(@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                            </div>
                            <a class="btn btn-outline-danger btn-sm w-100" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                            </a>
                        }
                    </div>
                    </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 p-4">
                @RenderBody() 
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>