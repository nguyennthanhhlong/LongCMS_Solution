@model IEnumerable<CMS.Data.Entities.CategoryProduct>
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Danh mục sản phẩm"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0 text-dark"><i class="bi bi-tags text-primary me-2"></i>DANH MỤC SẢN PHẨM</h3>
    
    <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
        <i class="bi bi-plus-lg me-1"></i> Thêm mới
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="border-0">ID</th>
                        <th class="border-0" style="width: 80px; text-align:center;">Hình ảnh</th>
                        <th class="border-0">Tên danh mục</th>
                        <th class="border-0">Mô tả</th>
                        <th class="border-0 text-center" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td>@item.Id</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.ImageUrl)) {
                                    <img src="@item.ImageUrl" width="50" height="50" style="object-fit:cover;" class="rounded border" alt="No image" />
                                } else {
                                    <span class="text-muted small">No IMG</span>
                                }
                            </td>
                            <td class="fw-bold text-primary">@item.Name</td>
                            <td>@item.Description</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary rounded-circle" data-bs-toggle="tooltip" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" 
                                   class="btn btn-sm btn-light text-danger rounded-circle ms-1" data-bs-toggle="tooltip" title="Xóa"
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này không?')"><i class="bi bi-trash3"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-center">
                <nav aria-label="Page navigation">
                    <ul class="pagination mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="/CategoryProduct/Index?page=@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>