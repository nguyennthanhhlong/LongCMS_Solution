@model CMS.Data.Entities.Customer
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Cập nhật Khách hàng"; }

<div class="row justify-content-center">
    <div class="col-12 col-xl-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0 text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>CẬP NHẬT KHÁCH HÀNG</h3>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4 shadow-sm border">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card">
            <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Họ và tên khách hàng:</label>
                        <input asp-for="FullName" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Địa chỉ Email:</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Số điện thoại:</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Mật khẩu (Ghi đè nếu đổi):</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Để trống nếu không đổi mật khẩu" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Địa chỉ thường trú:</label>
                    <input asp-for="Address" class="form-control" />
                </div>

                <hr class="my-4" />
                <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm"><i class="bi bi-check2-circle me-1"></i> Xác nhận cập nhật</button> 
            </form>
        </div>
    </div>
</div>