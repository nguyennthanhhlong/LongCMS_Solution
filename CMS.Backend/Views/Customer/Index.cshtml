@model IEnumerable<CMS.Data.Entities.Customer>
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Khách hàng"; }

<div class="container mt-4">
    <h2 class="text-dark fw-bold mb-4">QUẢN LÝ KHÁCH HÀNG</h2>
    <table class="table table-hover bg-white shadow-sm">
        <thead class="table-dark">
            <tr><th>ID</th><th>Họ Tên</th><th>Email</th><th>Số điện thoại</th><th>Địa chỉ</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.Id</td>
                    <td class="fw-bold">@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.Address</td>
                </tr>
            }
        </tbody>
    </table>
</div>