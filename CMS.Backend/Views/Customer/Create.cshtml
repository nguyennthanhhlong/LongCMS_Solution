@model CMS.Data.Entities.Customer
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Thêm Khách hàng"; }

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-person-plus"></i> THÊM TÀI KHOẢN KHÁCH HÀNG</h5>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Họ và tên khách hàng:</label>
                        <input asp-for="FullName" class="form-control" required placeholder="Nhập họ tên..." />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Địa chỉ Email:</label>
                        <input asp-for="Email" type="email" class="form-control" required placeholder="name@example.com" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Số điện thoại:</label>
                        <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại..." />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Mật khẩu đăng nhập:</label>
                        <input asp-for="Password" type="password" class="form-control" required placeholder="Nhập mật khẩu..." />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Địa chỉ thường trú:</label>
                    <input asp-for="Address" class="form-control" placeholder="Số nhà, tên đường, tỉnh thành..." />
                </div>

                <hr />
                <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Lưu dữ liệu</button> 
                <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
            </form>
        </div>
    </div>
</div>