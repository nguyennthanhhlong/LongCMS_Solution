@model CMS.Data.Entities.Advertisement

@{
    ViewData["Title"] = "Thêm mới Banner";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0 text-dark"><i class="bi bi-plus-square text-primary me-2"></i>THÊM BANNER MỚI</h3>
            <a href="/Advertisement/Index" class="btn btn-light rounded-pill px-4 shadow-sm border">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="fw-bold form-label">Tiêu đề</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="fw-bold form-label">Hình ảnh (Upload)</label>
                    <input type="file" class="form-control" name="uploadImage" required />
                </div>
                <div class="mb-3">
                    <label class="fw-bold form-label">Đường dẫn (Link)</label>
                    <input asp-for="Link" class="form-control" />
                    <span asp-validation-for="Link" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="fw-bold form-label">Trạng thái</label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="true">Hiển thị</option>
                        <option value="false">Ẩn</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="fw-bold form-label">Thứ tự sắp xếp (Vị trí)</label>
                    <input asp-for="SortOrder" class="form-control" />
                    <span asp-validation-for="SortOrder" class="text-danger small"></span>
                </div>
                    <hr class="my-4" />
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm"><i class="bi bi-save me-1"></i> Lưu lại</button>
                </form>
            </div>
        </div>
    </div>
</div>
