@model CMS.Data.Entities.Advertisement

@{
    ViewData["Title"] = "Sửa Banner";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0 text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>CHỈNH SỬA BANNER</h3>
            <a href="/Advertisement/Index" class="btn btn-light rounded-pill px-4 shadow-sm border">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />
                <div class="mb-3">
                    <label class="fw-bold form-label">Tiêu đề</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="fw-bold form-label">Hình ảnh hiện tại</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" style="max-height: 100px;" class="rounded border" />
                        </div>
                    }
                    <input type="file" class="form-control" name="uploadImage" />
                    <small class="text-muted">Bỏ trống nếu không muốn thay đổi hình ảnh</small>
                </div>
                <div class="mb-3">
                    <label class="fw-bold form-label">Đường dẫn (Link)</label>
                    <input asp-for="Link" class="form-control" />
                    <span asp-validation-for="Link" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="fw-bold form-label">Trạng thái</label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="true">Hiển thị</option>
                        <option value="false">Ẩn</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="fw-bold form-label">Thứ tự sắp xếp (Vị trí)</label>
                    <input asp-for="SortOrder" class="form-control" />
                    <span asp-validation-for="SortOrder" class="text-danger small"></span>
                </div>
                    <hr class="my-4" />
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm"><i class="bi bi-check2-circle me-1"></i> Cập nhật</button>
                </form>
            </div>
        </div>
    </div>
</div>
