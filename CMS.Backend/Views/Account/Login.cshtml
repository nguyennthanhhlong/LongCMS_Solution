@{
    Layout = null; 
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập hệ thống - ThanhLongCMS</title>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        :root {
            --primary-color: #0ea5e9;
            --primary-hover: #0284c7;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(-45deg, #0ea5e9, #38bdf8, #818cf8, #4f46e5);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 20px;
        }

        @@keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .login-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            width: 100%;
            max-width: 450px;
            padding: 3rem 2.5rem;
            transform: translateY(0);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .login-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.3);
        }

        .brand-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--primary-color), #818cf8);
            color: white;
            border-radius: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            margin: 0 auto 1.5rem auto;
            box-shadow: 0 10px 25px -5px rgba(14, 165, 233, 0.5);
            transform: rotate(-5deg);
            transition: transform 0.3s ease;
        }

        .login-card:hover .brand-icon {
            transform: rotate(0deg) scale(1.05);
        }

        .login-title {
            font-weight: 800;
            color: #1e293b;
            text-align: center;
            margin-bottom: 0.5rem;
            letter-spacing: -0.5px;
        }

        .login-subtitle {
            color: #64748b;
            text-align: center;
            margin-bottom: 2.5rem;
            font-size: 0.95rem;
        }

        .form-floating > label {
            color: #64748b;
            padding-left: 1.25rem;
        }

        .form-control {
            border-radius: 1rem;
            padding: 1rem 1.25rem;
            border: 2px solid #e2e8f0;
            background-color: #f8fafc;
            color: #334155;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            border-color: var(--primary-color);
            background-color: #ffffff;
            box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.1);
        }

        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: var(--primary-color);
            font-weight: 600;
            transform: scale(0.85) translateY(-0.75rem) translateX(0.15rem);
        }

        .btn-login {
            background: linear-gradient(135deg, var(--primary-color), #3b82f6);
            border: none;
            border-radius: 1rem;
            padding: 1rem;
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: 0.5px;
            box-shadow: 0 10px 20px -5px rgba(14, 165, 233, 0.4);
            transition: all 0.3s ease;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 25px -5px rgba(14, 165, 233, 0.5);
            background: linear-gradient(135deg, var(--primary-hover), #2563eb);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .input-icon {
            position: absolute;
            right: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1.2rem;
            pointer-events: none;
            transition: color 0.2s ease;
        }

        .form-control:focus + .input-icon {
            color: var(--primary-color);
        }

        .alert-error {
            background-color: #fef2f2;
            border: 1px solid #fecaca;
            color: #ef4444;
            border-radius: 0.75rem;
            padding: 1rem;
            font-size: 0.9rem;
            font-weight: 500;
            display: flex;
            align-items: center;
        }

        .alert-error i {
            font-size: 1.25rem;
            margin-right: 0.5rem;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="brand-icon">
            <i class="bi bi-hexagon-fill"></i>
        </div>
        <h2 class="login-title">ThanhLong CMS</h2>
        <p class="login-subtitle">Đăng nhập để quản lý hệ thống</p>

        <form asp-action="Login" method="post">
            
            <div class="form-floating mb-4 position-relative">
                <input type="text" name="username" class="form-control" id="floatingInput" placeholder="Tên đăng nhập" required autocomplete="off" />
                <label for="floatingInput">Tên đăng nhập</label>
                <i class="bi bi-person input-icon"></i>
            </div>

            <div class="form-floating mb-4 position-relative">
                <input type="password" name="password" class="form-control" id="floatingPassword" placeholder="Mật khẩu" required />
                <label for="floatingPassword">Mật khẩu</label>
                <i class="bi bi-lock input-icon"></i>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-error mb-4">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    @ViewBag.Error
                </div>
            }

            <button type="submit" class="btn btn-primary w-100 btn-login">
                ĐĂNG NHẬP <i class="bi bi-arrow-right ms-2"></i>
            </button>
            
            <div class="text-center mt-4">
                <a href="#" class="text-decoration-none" style="color: #64748b; font-size: 0.85rem; font-weight: 500; transition: color 0.2s ease;" onmouseover="this.style.color='#0ea5e9'" onmouseout="this.style.color='#64748b'">Quên mật khẩu? Vui lòng liên hệ Admin</a>
            </div>
        </form>
    </div>

    <!-- Bootstrap JS (Optional but good for completeness) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>