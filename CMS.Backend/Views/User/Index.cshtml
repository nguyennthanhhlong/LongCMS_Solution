@model IEnumerable<CMS.Data.Entities.User>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý thành viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0 text-dark"><i class="bi bi-person-badge text-primary me-2"></i>QUẢN LÝ THÀNH VIÊN</h3>
    <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
        <i class="bi bi-person-plus-fill me-1"></i> Thêm mới
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="border-0">ID</th> 
                        <th class="border-0">Tên đăng nhập</th> 
                        <th class="border-0">Họ và Tên</th>
                        <th class="border-0">Vai trò (Role)</th>
                        <th class="border-0 text-center" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td>@item.Id</td>
                            <td class="fw-bold">@item.Username</td>
                            <td>@item.FullName</td>
                            <td>
                                @if(item.Role == "Admin") {
                                    <span class="badge bg-danger">@item.Role</span>
                                } else {
                                    <span class="badge bg-primary">@item.Role</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary rounded-circle" title="Sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" 
                                   class="btn btn-sm btn-light text-danger rounded-circle ms-1" 
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên @item.Username?')" title="Xóa">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>