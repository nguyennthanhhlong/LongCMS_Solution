@model IEnumerable<CMS.Data.Entities.Category>

    @{
    Layout = "_LayoutAdmin"; // Gọi khung giao diện vừa tạo
}

<div class="container mt-4">
    <h2 class="text-primary">DANH SÁCH DANH MỤC</h2>
    
    <a asp-action="Create" class="btn btn-success mb-3">
        + Thêm danh mục mới
    </a>

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Tên danh mục</th>
                <th>Mô tả</th>
                <th style="width:150px; text-align:center;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" 
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>