@model CMS.Data.Entities.Category

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sửa danh mục";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0 text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>CHỈNH SỬA DANH MỤC</h3>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4 shadow-sm border">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên danh mục:</label>
                        <input asp-for="Name" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả:</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>

                    <hr class="my-4" />
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm"><i class="bi bi-check2-circle me-1"></i> Cập nhật thay đổi</button>
                </form>
            </div>
        </div>
    </div>
</div>