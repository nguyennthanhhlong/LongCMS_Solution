@model CMS.Data.Entities.Category

@{
    Layout = "_LayoutAdmin"; // Gọi khung giao diện vừa tạo
    ViewData["Title"] = "Thêm danh mục mới";
}

<div class="container mt-4">
    <h2 class="text-primary">THÊM DANH MỤC MỚI</h2>
    <hr />

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label">Tên danh mục:</label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Mô tả:</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-success">Lưu vào hệ thống</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
    </form>
</div>