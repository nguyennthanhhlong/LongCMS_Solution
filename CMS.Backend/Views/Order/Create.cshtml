@model CMS.Data.Entities.Order
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Tạo đơn hàng mới"; }

<div class="row justify-content-center">
    <div class="col-12 col-xl-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0 text-dark"><i class="bi bi-cart-plus text-primary me-2"></i>KHỞI TẠO ĐƠN HÀNG</h3>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4 shadow-sm border">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card">
            <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Chọn Khách hàng đặt mua:</label>
                        <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerList" required>
                            <option value="">-- Chọn khách hàng hệ thống --</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Trạng thái khởi tạo:</label>
                        <select asp-for="Status" class="form-select">
                            <option value="0" selected>Chờ duyệt (Mặc định)</option>
                            <option value="1">Đang giao hàng</option>
                            <option value="2">Đã hoàn thành</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Thời gian lập đơn:</label>
                    <input asp-for="OrderDate" type="datetime-local" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Ghi chú giao nhận:</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Nhập yêu cầu giao hàng, địa chỉ phụ nếu có..."></textarea>
                </div>

                <hr class="my-4" />
                <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm"><i class="bi bi-save me-1"></i> Khởi tạo đơn</button> 
            </form>
        </div>
    </div>
</div>