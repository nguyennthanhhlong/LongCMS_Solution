@model IEnumerable<CMS.Data.Entities.Order>
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Quản lý đơn hàng"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold m-0">QUẢN LÝ ĐƠN HÀNG</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-cart-plus"></i> Tạo đơn hàng mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-bordered table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 100px; text-align: center;">Mã ĐH</th>
                        <th>Ngày đặt hàng</th>
                        <th>Khách hàng</th>
                        <th>Trạng thái đơn hàng</th>
                        <th>Ghi chú đơn</th>
                        <th class="text-center" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="text-center fw-bold text-danger">#@item.Id</td>
                            <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-primary">@(item.Customer != null ? item.Customer.FullName : "Không rõ khách hàng")</td>
                            <td>
                                @if (item.Status == 0) {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> Chờ duyệt</span>
                                } else if (item.Status == 1) {
                                    <span class="badge bg-primary"><i class="bi bi-truck"></i> Đang giao</span>
                                } else if (item.Status == 2) {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Đã hoàn thành</span>
                                }
                            </td>
                            <td class="text-muted small">@item.Notes</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Cập nhật</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" 
                                   class="btn btn-sm btn-outline-danger" 
                                   onclick="return confirm('Xóa đơn hàng này sẽ ảnh hưởng đến dữ liệu chi tiết. Bạn có chắc muốn xóa?')">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>