@model IEnumerable<CMS.Data.Entities.Order>
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Quản lý đơn hàng"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0 text-dark"><i class="bi bi-cart3 text-primary me-2"></i>QUẢN LÝ ĐƠN HÀNG</h3>
    <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
        <i class="bi bi-plus-lg me-1"></i> Tạo đơn hàng mới
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
            <table class="table table-bordered table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="border-0" style="width: 100px; text-align: center;">Mã ĐH</th>
                        <th class="border-0">Ngày đặt hàng</th>
                        <th class="border-0">Khách hàng</th>
                        <th class="border-0">Trạng thái đơn hàng</th>
                        <th class="border-0">Ghi chú đơn</th>
                        <th class="border-0 text-center" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="text-center fw-bold text-danger">#@item.Id</td>
                            <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-primary">@(item.Customer != null ? item.Customer.FullName : "Không rõ khách hàng")</td>
                            <td>
                                @if (item.Status == 0) {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> Chờ duyệt</span>
                                } else if (item.Status == 1) {
                                    <span class="badge bg-primary"><i class="bi bi-truck"></i> Đang giao</span>
                                } else if (item.Status == 2) {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Đã hoàn thành</span>
                                }
                            </td>
                            <td class="text-muted small">@item.Notes</td>
                            <td class="text-center">
                                <a asp-controller="OrderDetail" asp-action="Index" asp-route-orderId="@item.Id" class="btn btn-sm btn-light text-info rounded-circle" data-bs-toggle="tooltip" title="Xem chi tiết"><i class="bi bi-list-ul"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary rounded-circle ms-1" data-bs-toggle="tooltip" title="Cập nhật"><i class="bi bi-pencil-square"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" 
                                   class="btn btn-sm btn-light text-danger rounded-circle ms-1" data-bs-toggle="tooltip" title="Xóa"
                                   onclick="return confirm('Xóa đơn hàng này sẽ ảnh hưởng đến dữ liệu chi tiết. Bạn có chắc muốn xóa?')"><i class="bi bi-trash3"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-center">
                <nav aria-label="Page navigation">
                    <ul class="pagination mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="/Order/Index?page=@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>