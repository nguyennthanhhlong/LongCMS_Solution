@model IEnumerable<CMS.Data.Entities.Product>
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Sản phẩm"; }

<div class="container mt-4">
    <h2 class="text-dark fw-bold mb-4">DANH SÁCH SẢN PHẨM</h2>
    <table class="table table-bordered table-striped bg-white shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Ảnh</th><th>Tên sản phẩm</th><th>Danh mục</th><th>Giá (VNĐ)</th><th>Tồn kho</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td><img src="@item.ImageUrl" width="50" height="50" style="object-fit:cover" /></td>
                    <td class="fw-bold text-primary">@item.Name</td>
                    <td>@(item.CategoryProduct != null ? item.CategoryProduct.Name : "N/A")</td>
                    <td class="text-danger fw-bold">@item.Price.ToString("N0")</td>
                    <td>@item.StockQuantity</td>
                </tr>
            }
        </tbody>
    </table>
</div>