@model IEnumerable<CMS.Data.Entities.Product>
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Quản lý sản phẩm"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold m-0">DANH SÁCH SẢN PHẨM</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm sản phẩm mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-bordered table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px; text-align:center;">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá bán</th>
                        <th>Số lượng tồn</th>
                        <th class="text-center" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="text-center">
                                <img src="@item.ImageUrl" width="50" height="50" style="object-fit:cover;" class="rounded border" alt="No image" />
                            </td>
                            <td class="fw-bold text-primary">@item.Name</td>
                            <td>@(item.CategoryProduct != null ? item.CategoryProduct.Name : "Chưa phân loại")</td>
                            <td class="text-danger fw-bold">@item.Price.ToString("N0") VNĐ</td>
                            <td>@item.StockQuantity</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" 
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?')">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>