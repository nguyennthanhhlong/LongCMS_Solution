@model CMS.Data.Entities.Product
@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Cập nhật sản phẩm"; }

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0 text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>CẬP NHẬT SẢN PHẨM</h3>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4 shadow-sm border">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card">
            <div class="card-body p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên sản phẩm:</label>
                            <input asp-for="Name" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả sản phẩm:</label>
                            <textarea asp-for="Description" class="form-control" rows="8"></textarea>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Danh mục thuộc về:</label>
                            <select asp-for="CategoryProductId" class="form-select" asp-items="ViewBag.CategoryProductList" required></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Giá bán (VNĐ):</label>
                            <input asp-for="Price" type="number" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Số lượng tồn kho:</label>
                            <input asp-for="StockQuantity" type="number" class="form-control" required />
                        </div>
                        <div class="mb-3 text-center">
                            <label class="form-label fw-bold text-start w-100">Hình ảnh hiện tại:</label>
                            <img src="@Model.ImageUrl" style="width: 100%; max-height: 150px; object-fit: cover;" class="rounded border mb-2" alt="No image" />
                            <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                            <small class="text-muted">Chỉ tải lên ảnh mới nếu muốn thay đổi.</small>
                        </div>
                        
                        <hr class="my-4" />
                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 shadow-sm"><i class="bi bi-check2-circle me-1"></i> Lưu thay đổi</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>