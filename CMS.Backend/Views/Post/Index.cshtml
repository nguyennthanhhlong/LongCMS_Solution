@model IEnumerable<CMS.Data.Entities.Post>

@{
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0 text-dark"><i class="bi bi-file-earmark-post text-primary me-2"></i>DANH SÁCH BÀI VIẾT</h3>
    
    <a asp-action="Create" class="btn btn-primary shadow-sm rounded-pill px-4">
        <i class="bi bi-plus-lg me-1"></i> Thêm mới
    </a>
</div>

<div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100 border-0">
                    <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <span class="badge bg-info text-dark mb-2">@(item.Category != null ? item.Category.Name : "Không rõ")</span>
                        <h5 class="card-title text-primary fw-bold">@item.Title</h5>
                        
                        <div class="card-text text-truncate mb-2" style="max-height: 50px; overflow: hidden;">
                            @Html.Raw(item.Content)
                        </div>
                        
                        <p class="text-muted small"><i class="bi bi-calendar3"></i> Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")</p>
                        
                        <hr />
                        
                        <div class="d-flex justify-content-between">
                            <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" 
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?')">Xóa</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="/Post/Index?id=@ViewBag.CategoryId&page=@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }